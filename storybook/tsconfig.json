{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2025", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Storybook builds manager entries with React.createElement, so React must be in scope
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // Node runs the docgen worker and the tests without a build step
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    // Reads the types of the JavaScript manifest helpers from their JSDoc
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  // Stories stay in JavaScript like the dev pages and tests
  "include": [".storybook/*.ts", "addons", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
